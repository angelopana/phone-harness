{
  "name": "@phone-harness/openclaw",
  "version": "0.1.0",
  "description": "Drive a real phone from OpenClaw with one phone_exec tool (iPhone via iPhone Mirroring, Android over adb, or a cloud phone)",
  "license": "MIT",
  "author": "Shawn Pana",
  "homepage": "https://phone-harness.com",
  "type": "module",
  "files": [
    "dist/",
    "skills/",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-skill.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'"
  },
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.10.7",
    "typescript": "^5.9.0"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.10.7",
      "minGatewayVersion": "2026.10.7"
    },
    "build": {
      "openclawVersion": "2026.10.7",
      "pluginSdkVersion": "2026.10.7"
    }
  }
